HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
ADMIN_EMAIL=admin@example.com
# At least 12 characters; used only to bootstrap an empty database.
ADMIN_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
COOKIE_SECURE=false
MAX_UPLOAD_MB=1024
MAX_OUTPUTS=4
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# CPU fallback only; stream copy ignores this. Keep two encoder threads.
STREAM_PRESET=ultrafast
